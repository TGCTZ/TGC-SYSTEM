# Copy to .env and fill in real values. Never commit the real .env.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tgc_system
DB_USER=tgc_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Localization ---
TIME_ZONE=Africa/Dar_es_Salaam

# --- Superuser (reminder of admin credentials) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=email@domain
DJANGO_SUPERUSER_PASSWORD=change-me

# --- GePG (Government Electronic Payment Gateway) ---
GEPG_BILL_CREATE_URL=
GEPG_BILL_CANCEL_URL=
GEPG_RECONCILIATION_URL=
GEPG_SP_GRP_CODE=
GEPG_SYS_CODE=
GEPG_SP_CODE=
GEPG_SUB_SP_CODE=
GEPG_COLL_CENT_CODE=
GEPG_GFS_CODE=
GEPG_USE_DIGITAL_SIGNATURE=False
GEPG_CERTIFICATE_PASSWORD=
GEPG_PRIVATE_KEY_PATH=
GEPG_PUBLIC_CERT_PATH=
GEPG_BILL_EXPIRY_DAYS=365

# --- Beem Africa SMS ---
BEEM_AFRICA_API_KEY=
BEEM_AFRICA_SECRET_KEY=
