// ============================================================
// TGC-SYSTEM — Database Schema (DBML)
// Paste into https://dbdiagram.io to render the ERD.
//
// Tables are ordered by dependency: a table only references
// tables defined ABOVE it. The schema is normalized; reference
// data is modelled as lookup tables and workflow states as enums.
//
// AUDIT & SOFT DELETE:
//   Every CRUD table inherits the six audit columns via the
//   `audit` TablePartial (injected as `~audit`) — defined once,
//   from core.BaseModel. Records are NEVER physically deleted;
//   delete() sets deleted_at. Append-only log tables
//   (status_history, certificate_access_log) are exceptions.
//   (Requires a DBML v3 renderer, e.g. dbdiagram.io.)
//
// (open: Bn/Cn) = depends on a question in ../domain/domain-questions.md
// ============================================================


// ---------- Audit columns (shared by every CRUD table) ----------

TablePartial audit {
  created_at  timestamptz [not null]
  created_by  bigint      [note: 'FK > user.id, SET_NULL']
  updated_at  timestamptz [not null]
  updated_by  bigint      [note: 'FK > user.id, SET_NULL']
  deleted_at  timestamptz [note: 'null = live row; set = soft-deleted']
  deleted_by  bigint      [note: 'FK > user.id, SET_NULL']
}


// ---------- Enums (code-defined; logic branches on these) ----------

Enum stone_status {
  received
  under_identification
  billed
  paid
  certified
  ready_for_collection
  collected
  on_hold
  cancelled
}

Enum stone_category {
  precious
  semi_precious
  diamond
}

Enum bill_status {           // (open: C2 — partial payments)
  pending
  partially_paid
  paid
  cancelled
  expired
}

Enum certificate_status {    // (open: C3)
  issued
  revoked
  reissued
}

// Reference values that are fixed/scientific — code enums, not tables.

Enum transparency {
  transparent
  translucent
  opaque
}

Enum optic_character {       // stored as the short code; label expands in code
  sr                         // Singly refractive
  adr                        // Anomalous double refractive
  dr                         // Double refractive
  agg                        // Aggregate
}

Enum nature_type {
  natural
  synthetic
  treated
  enhanced
  artificial
}

Enum weight_unit {
  carat                      // symbol: ct
  gram                       // symbol: g
}

Enum treatment {             // fixed set (draft — team to confirm values)
  none
  heated
  oiled
  dyed
  irradiated
  fracture_filled
  bleached
  impregnated
}

// Color family grouping the `color` lookup into <optgroup>s on the findings
// form. The GIA-style groups and their ~37 seeded values are ported from the
// legacy finding form; the values live in the `color` TABLE below.
Enum color_group {
  white_grey_black
  purple_violet
  red_pink
  orange_yellow
  green
  blue
}


// ============================================================
// L2 — accounts
// Roles & permissions use Django's built-in auth (Group = role);
// no custom role table. auth_group / auth_permission omitted.
// ============================================================

Table user {                 // extends Django AbstractUser
  id            bigint       [pk, increment]
  username      varchar(150) [not null, unique]
  email         varchar(254) [not null]
  password      varchar(128) [not null]
  first_name    varchar(150)
  last_name     varchar(150)
  is_active     boolean      [not null, default: true]
  is_staff      boolean      [not null, default: false]
  date_joined   timestamptz  [not null]
  ~audit
}


// ============================================================
// L1 — core (reference/master data + pricing)
// ============================================================

Table stone_type {
  id            bigint         [pk, increment]
  name          varchar(100)   [not null]
  category      stone_category [not null, note: 'drives pricing (A6)']
  is_active     boolean        [not null, default: true]
  ~audit
  indexes { (name) [unique, note: 'partial: WHERE deleted_at IS NULL'] }
}

Table species {
  id            bigint       [pk, increment]
  name          varchar(100) [not null]
  is_active     boolean      [not null, default: true]
  ~audit
}

Table variety {
  id            bigint       [pk, increment]
  name          varchar(100) [not null]
  species_id    bigint       [ref: > species.id, note: 'PROTECT']
  is_active     boolean      [not null, default: true]
  ~audit
  indexes { (name, species_id) [unique, note: 'partial: WHERE deleted_at IS NULL'] }
}

Table color {                // GIA-style values, grouped by color_group
  id            bigint      [pk, increment]
  name          varchar(100) [not null, note: 'e.g. "Violetish Purple"']
  "group"       color_group [not null]
  is_active     boolean     [not null, default: true]
  ~audit
}

Table origin {
  id            bigint       [pk, increment]
  name          varchar(100) [not null]
  is_active     boolean      [not null, default: true]
  ~audit
}

Table shape_cut {
  id            bigint       [pk, increment]
  name          varchar(100) [not null]
  is_active     boolean      [not null, default: true]
  ~audit
}

Table instrument {
  id            bigint       [pk, increment]
  name          varchar(100) [not null]
  is_active     boolean      [not null, default: true]
  ~audit
}

Table stone_price {          // flat: one fixed price per stone type (A6, B2)
  id             bigint        [pk, increment]
  stone_type_id  bigint        [not null, unique, ref: - stone_type.id, note: 'OneToOne, PROTECT']
  price          decimal(12,2) [not null, note: 'flat amount; weight-independent']
  ~audit
}


// ============================================================
// L3 — orders (intake: customer -> order -> stone)
// ============================================================

Table customer {             // (open: C1)
  id            bigint       [pk, increment]
  first_name    varchar(100) [not null]
  middle_name   varchar(100)
  last_name     varchar(100) [not null]
  phone         varchar(20)  [not null, note: 'unique (live)']
  email         varchar(254)
  company_name  varchar(255)
  region        varchar(100)
  id_number     varchar(50)
  address       varchar(255)
  ~audit
}

Table "order" {
  id            bigint       [pk, increment]
  reference_no  varchar(30)  [not null, note: 'unique (live); (open: C6)']
  customer_id   bigint       [not null, ref: > customer.id, note: 'PROTECT']
  received_date date         [not null]
  stone_count   integer      [not null, note: 'count submitted at reception']
  ~audit
  Note: 'Reception records only stone_count. No status column — status lives on each Stone (A7). Stones are created later, at identification.'
}

Table stone {
  id             bigint        [pk, increment]
  order_id       bigint        [not null, ref: > "order".id, note: 'CASCADE (soft, via service)']
  label          varchar(20)   [not null, note: 'e.g. A, B within the order']
  stone_type_id  bigint        [not null, ref: > stone_type.id, note: 'PROTECT; set at type identification']
  weight         decimal(10,3) [note: 'null until findings are recorded (after payment)']
  weight_unit    weight_unit   [not null, default: 'carat']
  status         stone_status  [not null, default: 'received']
  ~audit
  Note: 'One record per physical stone, created when its type is identified (add_stone); capped by order.stone_count. Weight and full findings are recorded later, after payment.'
  indexes { (status) }
}

Table status_history {       // APPEND-ONLY audit record (A9) — no soft delete
  id            bigint       [pk, increment]
  stone_id      bigint       [not null, ref: > stone.id, note: 'CASCADE']
  from_status   stone_status [note: 'blank on first entry']
  to_status     stone_status [not null]
  changed_by    bigint       [note: 'FK > user.id, SET_NULL']
  changed_at    timestamptz  [not null]
  note          varchar(255)
  indexes { (stone_id, changed_at) }
}


// ============================================================
// L3 — identification (one report per stone; A2)
// Recorded AFTER payment: phase 1 sets the stone type (price),
// then the customer pays, then the gemmologist records findings.
// ============================================================

Table identification_report {
  id                 bigint      [pk, increment]
  stone_id           bigint      [not null, unique, ref: - stone.id, note: 'OneToOne']
  report_number      varchar(50) [not null, note: 'unique (live)']
  species_id         bigint      [ref: > species.id, note: 'PROTECT']
  variety_id         bigint      [ref: > variety.id, note: 'PROTECT']
  origin_id          bigint      [ref: > origin.id, note: 'PROTECT']
  shape_cut_id       bigint      [ref: > shape_cut.id, note: 'PROTECT']
  color_id           bigint      [ref: > color.id, note: 'SET_NULL']
  nature_type        nature_type     [note: 'enum']
  transparency       transparency    [note: 'enum']
  treatment          treatment       [note: 'enum']
  optic_character    optic_character [note: 'enum']
  dimensions         varchar(50) [note: 'L x W x D in mm, free text']
  refractive_index   varchar(50)
  specific_gravity   decimal(10,3)
  is_polished        boolean     [not null, default: false]
  conclusion         text
  is_finalized       boolean     [not null, default: false, note: 'locks report; (open: C4)']
  identified_by      bigint      [note: 'FK > user.id, SET_NULL']
  identified_at      timestamptz
  ~audit
}

Table instrument_used {
  id            bigint       [pk, increment]
  report_id     bigint       [not null, ref: > identification_report.id, note: 'CASCADE (soft)']
  instrument_id bigint       [not null, ref: > instrument.id, note: 'PROTECT']
  reading       varchar(100)
  ~audit
}


// ============================================================
// L3 — billing (one bill per order; A4)
// ============================================================

Table service_provider {
  id            bigint       [pk, increment]
  sp_code       varchar(20)  [not null, note: 'unique (live)']
  name          varchar(255) [not null]
  group_code    varchar(20)
  sys_code      varchar(20)
  is_active     boolean      [not null, default: true]
  ~audit
}

Table bill {
  id                  bigint        [pk, increment]
  order_id            bigint        [not null, unique, ref: - "order".id, note: 'OneToOne, PROTECT']
  bill_number         varchar(50)   [not null, note: 'unique (live)']
  control_number      varchar(50)   [note: 'unique (live); from GePG']
  service_provider_id bigint        [ref: > service_provider.id, note: 'PROTECT']
  total_amount        decimal(15,2) [not null, default: 0, note: 'Σ bill_item.amount']
  currency            varchar(3)    [not null, default: 'TZS']
  status              bill_status   [not null, default: 'pending', note: 'domain state']
  issued_at           timestamptz
  expiry_at           timestamptz
  due_date            date
  bill_type           smallint      [not null, default: 1, note: 'GePG']
  pay_type            smallint      [not null, default: 1, note: 'GePG']
  status_code         varchar(30)   [note: 'GePG raw gateway state']
  status_desc         varchar(255)  [note: 'GePG raw gateway state']
  gepg_submitted      boolean       [not null, default: false]
  gepg_submitted_at   timestamptz
  ~audit
}

Table bill_item {            // one per stone; price SNAPSHOTTED at billing
  id            bigint        [pk, increment]
  bill_id       bigint        [not null, ref: > bill.id, note: 'CASCADE (soft)']
  stone_id      bigint        [not null, ref: > stone.id, note: 'PROTECT']
  description   varchar(255)  [not null]
  unit_price    decimal(15,2) [not null, note: 'SNAPSHOT of the stone type''s flat price']
  weight        decimal(10,3) [note: 'SNAPSHOT at billing (informational; price is flat)']
  amount        decimal(15,2) [not null, note: 'SNAPSHOT = the flat price charged']
  gfs_code      varchar(20)   [note: 'GePG']
  item_ref      varchar(50)   [note: 'GePG']
  ~audit
}

Table payment {              // one row per GePG payment notification (PmtTrxInf)
  id            bigint        [pk, increment]
  bill_id       bigint        [ref: > bill.id, note: 'PROTECT']
  req_id        varchar(100)  [note: 'PmtHdr']
  grp_bill_id   varchar(100)
  sp_grp_code   varchar(10)
  cust_cntr_num varchar(12)   [note: 'customer control number']
  entry_count   integer
  sp_code       varchar(10)
  gepg_bill_id  varchar(100)
  bill_ctr_num  varchar(12)
  psp_code      varchar(10)
  psp_name      varchar(200)
  trx_id        varchar(100)  [note: 'unique (live, non-blank)']
  pay_ref_id    varchar(100)
  bill_amount   decimal(15,2)
  paid_amount   decimal(15,2)
  bill_pay_opt  varchar(1)
  currency      varchar(3)
  coll_acc_num  varchar(50)
  trx_dt_tm     timestamptz
  usd_pay_chnl  varchar(50)   [note: 'payment channel used']
  pyr_cell_num  varchar(15)
  pyr_email     varchar(150)
  pyr_name      varchar(200)
  ack_id        varchar(100)  [note: 'acknowledgement we returned']
  ack_sts_code  varchar(10)
  processed     boolean       [not null, default: false]
  raw_request   text          [note: 'raw callback payload']
  ~audit
}


// ============================================================
// L3 — certificates (one per stone; A5)
// Snapshot fields are intentional — a certificate freezes its data.
// ============================================================

Table certificate {
  id                 bigint      [pk, increment]
  stone_id           bigint      [not null, unique, ref: - stone.id, note: 'OneToOne, PROTECT']
  report_id          bigint      [not null, ref: > identification_report.id, note: 'PROTECT (source)']
  certificate_no     varchar(30) [not null, note: 'unique (live); (open: C6)']
  verification_token varchar(64) [not null, note: 'unique (live); public QR URL']
  stone_type_snapshot varchar(100) [not null]
  weight_snapshot     decimal(10,3) [not null]
  color_snapshot      varchar(100)
  origin_snapshot     varchar(100)
  gemmologist         varchar(100) [note: 'snapshot of report gemmologist name']
  qr_code             varchar(100)
  pdf_file            varchar(100)
  status              certificate_status [not null, default: 'issued', note: '(open: C3)']
  issued_by           bigint      [note: 'FK > user.id, SET_NULL']
  issued_at           timestamptz [not null]
  ~audit
}

Table certificate_access_log {  // APPEND-ONLY log — no soft delete
  id             bigint      [pk, increment]
  certificate_id bigint      [not null, ref: > certificate.id, note: 'CASCADE']
  accessed_at    timestamptz [not null]
  ip_address     varchar(45)
  user_agent     varchar(255)
}
