# ============================================================
# .gitignore for TGC-SYSTEM (Django)
# Curated to fit this project. Mirrors the "never commit" rules
# in docs/engineering/conventions.md section 22.
# Note: git does not support trailing/inline comments — every
# comment must be on its own line.
# ============================================================

# --- Secrets & environment ---
.env
.env.*
# keep the committed template; ignore real env files
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Django ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
# user uploads (runtime)
/media/
# collectstatic output (generated)
/staticfiles/

# --- Translations (i18n) ---
*.mo
*.pot

# --- Database dumps (use factories/seeding, never commit) ---
*.sql
*.sqlite
*.dump
# Intentional, curated fixtures should be committed explicitly:
#   git add -f apps/<app>/fixtures/<name>.json

# --- Celery (uncomment when a task queue is added) ---
# celerybeat-schedule
# celerybeat.pid

# --- Testing & coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
